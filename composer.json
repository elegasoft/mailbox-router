{
    "name": "elegasoft/mailbox-router",
    "description": "A Boilerplate for registering and managing Mailboxes with beyondcode/laravel-mailbox",
    "keywords": [
        "elegasoft",
        "mailbox",
        "laravel",
        "router"
    ],
    "homepage": "https://github.com/elegasoft/mailbox-router",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jason Cook",
            "email": "jason@elegasoft.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "beyondcode/laravel-mailbox": "^5.0|^6.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "rector/rector": "^2.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Elegasoft\\Mailbox\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elegasoft\\Mailbox\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elegasoft\\Mailbox\\MailboxRouterServiceProvider"
            ]
        }
    }
}
